# Compose settings (rendered by Ansible as /opt/te-tengo/.env, 0600). Example values only.
TT_HOSTNAME='api.example.com'
ACME_EMAIL='ops@example.com'
# acme (Let's Encrypt; certificates in acme-v02.api.letsencrypt.org-directory) or internal (Caddy CA; local)
CADDY_CERT_ISSUER='acme'
CADDY_CERT_DIR='acme-v02.api.letsencrypt.org-directory'
HTTP_PORT='80'
HTTPS_PORT='443'
RTSPS_PORT='8322'
API_IMAGE='ghcr.io/te-tengo-tech/te-tengo-general-api:latest'
POSTGRES_IMAGE='postgres:18'
CADDY_IMAGE='caddy:2.11-alpine'
MEDIAMTX_IMAGE='bluenviron/mediamtx:1.21.1'
POSTGRES_DB='tetengo'
POSTGRES_USER='tetengo'
POSTGRES_PASSWORD='change-me-at-least-16-chars'
POSTGRES_SHARED_BUFFERS='96MB'
POSTGRES_EFFECTIVE_CACHE_SIZE='384MB'
POSTGRES_WORK_MEM='4MB'
POSTGRES_MAINTENANCE_WORK_MEM='32MB'
POSTGRES_MAX_CONNECTIONS='30'
POSTGRES_MEM_LIMIT='384m'
API_MEM_LIMIT='1024m'
MEDIAMTX_MEM_LIMIT='192m'
CADDY_MEM_LIMIT='128m'
API_JAVA_OPTS='-Xms192m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -Xss512k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError'
MEDIAMTX_AUTH_SECRET='<openssl rand -hex 32; same value as TT_VIVO_SECRETO_AUTORIZACION>'
