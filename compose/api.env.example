# te-tengo-general-api settings (rendered by Ansible as /opt/te-tengo/api.env, 0600). Example values
# only; the variables are described in the API's README ("Configuration") and docs/NOTIFICATIONS.md.
SERVER_FORWARD_HEADERS_STRATEGY='native'
SPRING_DATASOURCE_URL='jdbc:postgresql://postgres:5432/tetengo'
SPRING_DATASOURCE_USERNAME='tetengo'
SPRING_DATASOURCE_PASSWORD='change-me-at-least-16-chars'
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE='8'
SPRINGDOC_API_DOCS_ENABLED='false'
SPRINGDOC_SWAGGER_UI_ENABLED='false'
# Files written by Ansible into ./secrets (mounted read-only at /run/secrets/te-tengo).
TT_JWT_CLAVE_PUBLICA='file:/run/secrets/te-tengo/jwt-publica.pem'
TT_JWT_CLAVE_PRIVADA='file:/run/secrets/te-tengo/jwt-privada.pem'
# Clips: private Cloudflare R2 bucket through its S3 API (production). The endpoint is also the host of
# the pre-signed upload/playback URLs. Keys: an R2 API token with Object Read & Write on this bucket
# (Ansible vault). On the AWS alternative leave TT_CLIPS_ENDPOINT and the keys unset: the instance role signs.
TT_CLIPS_BUCKET='te-tengo-clips'
TT_CLIPS_REGION='auto'
TT_CLIPS_ENDPOINT='https://<ACCOUNT_ID>.r2.cloudflarestorage.com'
TT_CLIPS_PATH_STYLE='true'
TT_CLIPS_ACCESS_KEY='<R2 access key id>'
TT_CLIPS_SECRET_KEY='<R2 secret access key>'
# E-mail through a generic SMTP relay (smtp), or Amazon SES (ses, with TT_SES_REMITENTE and
# TT_SES_REGION), or only logged (registro).
TT_CORREO_PROVEEDOR='smtp'
TT_SMTP_REMITENTE='Te Tengo <no-responder@tetengo.reqsai.tech>'
SPRING_MAIL_HOST='smtp.example.com'
SPRING_MAIL_PORT='587'
SPRING_MAIL_USERNAME='<relay user>'
SPRING_MAIL_PASSWORD='<relay password or API key>'
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH='true'
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE='true'
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED='true'
# Push through Firebase Cloud Messaging; the key comes from the vault.
TT_PUSH_PROVEEDOR='fcm'
TT_FCM_CREDENCIALES='/run/secrets/te-tengo/fcm.json'
# Live view (MediaMTX).
TT_URL_TRANSMISION='wss://api.tetengo.reqsai.tech'
TT_VIVO_URL_PUBLICACION='rtsps://api.tetengo.reqsai.tech:8322/camaras/{camaraId}'
TT_VIVO_URL_HLS='https://api.tetengo.reqsai.tech/vivo'
# Live view v3: WebRTC (WHEP) endpoint of a camera; empty turns WebRTC playback off (urlWebrtc null)
TT_VIVO_URL_WEBRTC='https://api.tetengo.reqsai.tech/vivo-webrtc/camaras/{camaraId}/whep'
TT_VIVO_MEDIAMTX_API='http://mediamtx:9997'
TT_VIVO_SECRETO_AUTORIZACION='<same value as MEDIAMTX_AUTH_SECRET>'
