# te-tengo-general-api settings (rendered by Ansible as /opt/te-tengo/api.env, 0600). Example values
# only; the variables are described in the API's README ("Configuration") and docs/NOTIFICATIONS.md.
SERVER_FORWARD_HEADERS_STRATEGY='native'
SPRING_DATASOURCE_URL='jdbc:postgresql://postgres:5432/tetengo'
SPRING_DATASOURCE_USERNAME='tetengo'
SPRING_DATASOURCE_PASSWORD='change-me-at-least-16-chars'
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE='8'
SPRINGDOC_API_DOCS_ENABLED='false'
SPRINGDOC_SWAGGER_UI_ENABLED='false'
# Files written by Ansible into ./secrets (mounted read-only at /run/secrets/te-tengo).
TT_JWT_CLAVE_PUBLICA='file:/run/secrets/te-tengo/jwt-publica.pem'
TT_JWT_CLAVE_PRIVADA='file:/run/secrets/te-tengo/jwt-privada.pem'
# Clips: S3 bucket from Terraform; credentials from the instance role (SDK default chain).
TT_CLIPS_BUCKET='te-tengo-clips-example'
TT_CLIPS_REGION='us-east-1'
# E-mail through Amazon SES (verified identity).
TT_CORREO_PROVEEDOR='ses'
TT_SES_REMITENTE='Te Tengo <no-responder@example.com>'
TT_SES_REGION='us-east-1'
# Push through Firebase Cloud Messaging; the key comes from the vault.
TT_PUSH_PROVEEDOR='fcm'
TT_FCM_CREDENCIALES='/run/secrets/te-tengo/fcm.json'
# Live view v2 (MediaMTX).
TT_URL_TRANSMISION='wss://api.example.com'
TT_VIVO_URL_PUBLICACION='rtsps://api.example.com:8322/camaras/{camaraId}'
TT_VIVO_URL_HLS='https://api.example.com/vivo'
TT_VIVO_MEDIAMTX_API='http://mediamtx:9997'
TT_VIVO_SECRETO_AUTORIZACION='<same value as MEDIAMTX_AUTH_SECRET>'
