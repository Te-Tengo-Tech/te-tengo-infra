---
# Normally generated by Terraform (`make inventory`, from envs/azure), with the variables of
# docs/interface-terraform-ansible.md; see docs/deploy.md. Production runs on Azure over plain SSH (key
# only); the inactive OCI alternative (`make inventory ENV_DIR=envs/oci`) has the same shape with
# cloud_provider: oci. The inactive AWS alternative (envs/mvp) tunnels SSH through SSM instead:
#   ansible_host: i-0123456789abcdef0
#   ansible_ssh_common_args: >-
#     -o ProxyCommand="aws ssm start-session --region us-east-1 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p"
all:
  children:
    te_tengo:
      hosts:
        te-tengo-prod:
          ansible_host: 192.0.2.10
          ansible_user: ubuntu
          ansible_connection: ssh
          app_hostname: api.tetengo.reqsai.tech
          public_ip: 192.0.2.10
          cloud_provider: azure
          cloud_region: chilecentral
          memory_profile: tiny
          instance_architecture: amd64
          object_storage_endpoint: https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
          object_storage_region: auto
          object_storage_path_style: true
          object_storage_auth: static
          clips_s3_bucket: te-tengo-clips
          backup_s3_bucket: te-tengo-backups
          ses_sender: ""
          push_provider: fcm
          sns_platform_application_arn: ""
          live_view_publish_port: 8322
          live_view_webrtc_port: 8189
