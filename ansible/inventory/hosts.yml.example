---
# Normally generated by Terraform (`make inventory`, see docs/interface-terraform-ansible.md and
# docs/deploy.md). Access is through AWS Systems Manager: no SSH port is open on the instance.
all:
  children:
    te_tengo:
      hosts:
        te-tengo-mvp:
          ansible_host: i-0123456789abcdef0
          ansible_user: ubuntu
          ansible_ssh_common_args: >-
            -o ProxyCommand="aws ssm start-session --region us-east-1 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p"
          te_tengo_hostname: api.example.com
          te_tengo_memory_profile: small
          te_tengo_aws_region: us-east-1
          te_tengo_clips_bucket: te-tengo-clips-example
          te_tengo_backups_bucket: te-tengo-backups-example
          te_tengo_ses_sender: "Te Tengo <no-responder@example.com>"
