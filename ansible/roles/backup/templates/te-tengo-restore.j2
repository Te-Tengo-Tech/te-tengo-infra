#!/usr/bin/env bash
# Managed by Ansible (role backup). Restores a dump made by te-tengo-backup, replacing the database.
#   te-tengo-restore {{ backup_dir }}/te-tengo-20261007T083000Z.dump
{% if backup_target == 'azure' %}
#   te-tengo-restore {{ backup_prefix }}/te-tengo-20261007T083000Z.dump        (a dump in the backups container)
#   te-tengo-restore {{ backup_azure_container_url }}/{{ backup_prefix }}/te-tengo-20261007T083000Z.dump
#   te-tengo-restore latest        (newest dump in the backups container)
#   te-tengo-restore list          (dumps in the backups container; restores nothing)
# Credentials: /etc/te-tengo/backup.env (the VM's managed identity in production, role Storage Blob Data
# Contributor on the container, so the host lists and downloads directly).
{% elif backup_target == 's3' %}
#   te-tengo-restore s3://{{ backup_bucket | default('bucket', true) }}/{{ backup_s3_prefix }}/te-tengo-20261007T083000Z.dump
#   te-tengo-restore latest        (newest dump in the bucket)
#   te-tengo-restore list          (dumps in the bucket; restores nothing)
# Credentials: /etc/te-tengo/backup.env, unless AWS_ACCESS_KEY_ID is already exported.
# - Cloudflare R2: the backups token has Object Read & Write, so the host restores directly.
# - Amazon S3 (AWS alternative): the instance role may only WRITE to the backups bucket (least
#   privilege): export credentials allowed to read it first (e.g. a short-lived AWS_ACCESS_KEY_ID /
#   AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN of the operator), or copy the dump to the host.
{% else %}
#   te-tengo-restore latest        (newest dump on the host; no off-host copy is configured)
{% endif %}
# Dumps of the last days are also kept in {{ backup_dir }}.
set -euo pipefail
umask 077

source="${1:?usage: te-tengo-restore <path/to/file.dump | remote dump | latest | list>}"

{% if backup_target == 'azure' %}
set -a
# shellcheck disable=SC1091
. /etc/te-tengo/backup.env
set +a

{% include 'azure-blob.sh.j2' %}

if [[ "${source}" == list ]]; then
  blob_list_dumps
  exit 0
fi

key=""
if [[ "${source}" == latest ]]; then
  key="$(blob_list_dumps | tail -n1)"
  [[ -n "${key}" ]] || { echo "No dump in ${container_url}/{{ backup_prefix }}/" >&2; exit 1; }
elif [[ "${source}" == "${container_url}/"* ]]; then
  key="${source#"${container_url}/"}"
elif [[ ! -e "${source}" && "${source}" == {{ backup_prefix }}/te-tengo-*.dump ]]; then
  key="${source}"
fi

if [[ -n "${key}" ]]; then
  source="${container_url}/${key}"
  dump="{{ backup_dir }}/restore-$(date -u +%Y%m%dT%H%M%SZ).dump"
  blob_download "${key}" "${dump}"
else
  dump="${source}"
fi
{% elif backup_target == 's3' %}
if [[ -z "${AWS_ACCESS_KEY_ID:-}" ]]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/te-tengo/backup.env
  set +a
fi
export AWS_CONFIG_FILE="${AWS_CONFIG_FILE:-/etc/te-tengo/aws-config}"
export AWS_REQUEST_CHECKSUM_CALCULATION="${AWS_REQUEST_CHECKSUM_CALCULATION:-when_required}"
export AWS_RESPONSE_CHECKSUM_VALIDATION="${AWS_RESPONSE_CHECKSUM_VALIDATION:-when_required}"
aws_s3() {
  /usr/local/bin/aws s3 "$@" --region {{ backup_aws_region }}{{ ' --endpoint-url ' ~ backup_s3_endpoint if backup_s3_endpoint | length > 0 else '' }}
}

if [[ "${source}" == list ]]; then
  aws_s3 ls "s3://{{ backup_bucket }}/{{ backup_s3_prefix }}/" | awk '{print "{{ backup_s3_prefix }}/" $4}' | grep '/te-tengo-.*\.dump$' | sort
  exit 0
fi

if [[ "${source}" == latest ]]; then
  key="$(aws_s3 ls "s3://{{ backup_bucket }}/{{ backup_s3_prefix }}/" | awk '{print $4}' | grep '^te-tengo-.*\.dump$' | sort | tail -n1)"
  [[ -n "${key}" ]] || { echo "No dump in s3://{{ backup_bucket }}/{{ backup_s3_prefix }}/" >&2; exit 1; }
  source="s3://{{ backup_bucket }}/{{ backup_s3_prefix }}/${key}"
fi

if [[ "${source}" == s3://* ]]; then
  dump="{{ backup_dir }}/restore-$(date -u +%Y%m%dT%H%M%SZ).dump"
  aws_s3 cp "${source}" "${dump}" --only-show-errors
else
  dump="${source}"
fi
{% else %}
if [[ "${source}" == latest ]]; then
  source="$(ls -1 {{ backup_dir }}/te-tengo-*.dump | sort | tail -n1)"
fi
dump="${source}"
{% endif %}

cd {{ backup_app_dir }}

[[ -s "${dump}" ]] || { echo "Dump not found or empty: ${dump}" >&2; exit 1; }
echo "Restoring ${source}"

docker compose stop api
docker compose exec -T postgres sh -c 'dropdb --username="$POSTGRES_USER" --if-exists --force "$POSTGRES_DB" && createdb --username="$POSTGRES_USER" "$POSTGRES_DB"'
docker compose exec -T postgres sh -c 'pg_restore --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --no-owner --no-privileges --exit-on-error' < "${dump}"
docker compose start api
echo "Restored ${dump}; the API is starting again (docker compose ps api)."
