# Generated by Terraform (output ansible_inventory). Do not edit by hand: re-run `make inventory`.
# Variable contract: docs/interface-terraform-ansible.md
all:
  children:
    te_tengo:
      hosts:
        ${host_alias}:
          ansible_host: '${replace(ansible_host, "'", "''")}'
          ansible_user: ubuntu
          ansible_connection: ssh
%{ if use_ssm ~}
          ansible_ssh_common_args: >-
            -o ProxyCommand="aws ssm start-session --region ${aws_region} --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p"
%{ endif ~}
          app_hostname: '${replace(app_hostname, "'", "''")}'
          public_ip: '${replace(public_ip, "'", "''")}'
          cloud_provider: aws
          cloud_region: '${replace(aws_region, "'", "''")}'
          aws_region: '${replace(aws_region, "'", "''")}'
          memory_profile: '${replace(memory_profile, "'", "''")}'
          instance_architecture: '${replace(instance_architecture, "'", "''")}'
          object_storage_endpoint: '${replace(object_storage_endpoint, "'", "''")}'
          object_storage_region: '${replace(object_storage_region, "'", "''")}'
          object_storage_path_style: ${object_storage_path_style}
          object_storage_auth: ${object_storage_auth}
          clips_s3_bucket: '${replace(clips_s3_bucket, "'", "''")}'
          backup_s3_bucket: '${replace(backup_s3_bucket, "'", "''")}'
          ses_sender: '${replace(ses_sender, "'", "''")}'
          push_provider: '${replace(push_provider, "'", "''")}'
          sns_platform_application_arn: '${replace(sns_platform_application_arn, "'", "''")}'
          live_view_publish_port: ${live_view_publish_port}
          live_view_webrtc_port: ${live_view_webrtc_port}
