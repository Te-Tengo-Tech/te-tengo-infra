          clips_s3_bucket: '${replace(clips_s3_bucket, "'", "''")}'
          backup_s3_bucket: '${replace(backup_s3_bucket, "'", "''")}'
          ses_sender: ''
          push_provider: fcm
          sns_platform_application_arn: ''
          live_view_publish_port: ${live_view_publish_port}
