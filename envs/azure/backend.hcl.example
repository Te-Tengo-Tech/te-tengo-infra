# Copy to backend.hcl (git-ignored) and run: make azure-init
# Terraform state in the private `tfstate` container of the state storage account that bootstrap-azure/
# creates once (its outputs print these values). Authentication is Microsoft Entra ID through the Azure CLI
# login (`az login`): the account has shared key access disabled, so no access key or SAS is used or
# written here. The operator needs Storage Blob Data Contributor on the account (bootstrap-azure grants it
# to whoever applies it). Locking: the backend's native blob lease, no extra setting.
resource_group_name  = "te-tengo-tfstate-rg"
storage_account_name = "tetengotfstate"
container_name       = "tfstate"
key                  = "envs/azure/terraform.tfstate"
use_azuread_auth     = true
# Same subscription as terraform.tfvars (`az account show --query id -o tsv`).
subscription_id = "00000000-0000-0000-0000-000000000000"
