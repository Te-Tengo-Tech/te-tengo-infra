# Copy to terraform.tfvars (git-ignored) and fill in. Never put secrets here: Azure credentials come from
# `az login`, the R2 keys live in the Ansible vault and in ~/.aws/credentials (state backend).

# `az account show --query id -o tsv` (the Azure for Students subscription).
subscription_id = "00000000-0000-0000-0000-000000000000"
# Closest to Peru. The subscription's "Allowed resource deployment regions" policy only accepts
# canadacentral, chilecentral, northcentralus, westus and mexicocentral (docs/terraform.md).
location    = "chilecentral"
environment = "prod"

# 2 vCPU / 1 GiB (AMD), 750 free hours a month with Azure for Students -> memory profile "tiny".
# Upgrade path in chilecentral: Standard_B2als_v2 (2 vCPU / 4 GiB, billed) -> "medium".
vm_size = "Standard_B2ats_v2"

admin_username = "ubuntu"
ssh_public_key = "ssh-ed25519 AAAA... operator@te-tengo"
# Anywhere by default (Cloudflare WARP, GitHub-hosted runners); key-only SSH. Narrow it if you can.
admin_cidrs = ["0.0.0.0/0"]

# Standard SSD 30 GB (billed as E4). For a Premium SSD P6: "Premium_LRS" and 64.
os_disk_storage_account_type = "StandardSSD_LRS"
os_disk_size_gb              = 30

# A record at Namify: api.tetengo.reqsai.tech -> output public_ip. Empty: <ip-with-dashes>.sslip.io.
app_hostname = "api.tetengo.reqsai.tech"

# Cloudflare R2 (Dashboard > R2 > Overview: Account ID). Buckets are created by hand (docs/terraform.md).
object_storage_endpoint = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
object_storage_region   = "auto"
clips_bucket_name       = "te-tengo-clips"
backups_bucket_name     = "te-tengo-backups"

# Optional monthly budget alert (Cost Management lists Azure for Students as unsupported; leave empty
# unless the subscription is pay-as-you-go).
budget_alert_email = ""
budget_amount      = 5
